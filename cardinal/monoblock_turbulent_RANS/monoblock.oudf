// -----------------------------------------------------------
// RANS k-tau kernel
// -----------------------------------------------------------

@kernel void scalarScaledAdd(const dlong N, const dfloat a, const dfloat b,
                             @ restrict const dfloat *X, @ restrict dfloat *Y)
{
    for (dlong n = 0; n < N; ++n; @tile(256, @outer, @inner)) {
        if (n < N) {
            Y[n] = a + b * X[n];
        }
    }
}

// -----------------------------------------------------------
// Fluid Domain Boundary Conditions
// -----------------------------------------------------------

#include <cstdio>

void udfDirichlet(bcData *bc)
{
  if (isField("fluid velocity")) {
    if (bc->id == 1) {
      bc->uxFluid = 0.0;
      bc->uyFluid = 0.0;
      bc->uzFluid = -1.0;
    }
  } else if (isField("fluid pressure")) {
    bc->pFluid = 0.0;
  } else if (isField("scalar temperature")) {
    if (bc->id == 1) {
      bc->sScalar = 0.0;
    }
    if (bc->id == 3) {
      bc->sScalar =
          bc->usrwrk[bc->idxVol + 1 * bc->fieldOffset];
    }
  } else if (isField("scalar k")) {
    if (bc->id == 1) {
      bc->sScalar = k_inflow;
    }
    if (bc->id == 3) {
      bc->sScalar = 0.0;
    }
  } else if (isField("scalar tau")) {
    if (bc->id == 1) {
      bc->sScalar = tau_inflow;
    }
    if (bc->id == 3) {
      bc->sScalar = 0.0;
    }
  }
}
