// -----------------------------------------------------------
// Fluid Domain Boundary Conditions
// -----------------------------------------------------------

void udfDirichlet(bcData *bc)
{
  if (isField("scalar temperature")) {
    if (bc->id == 1) { // wall
      bc->sScalar = bc->usrwrk[bc->idxVol + 1 * bc->fieldOffset]; // temperature sent from MOOSE
    }
  }
}
