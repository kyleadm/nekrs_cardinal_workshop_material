// -----------------------------------------------------------
// Fluid Domain Boundary Conditions
// -----------------------------------------------------------

void udfDirichlet(bcData *bc)
{
  if (isField("fluid velocity")) { 
    // inlet boundary condition
    if (bc->id == 1)
      {
        const double r2 = (bc->x-cx0)*(bc->x-cx0) + (bc->y-cy0)*(bc->y-cy0);
        const double R2 = r_pipe*r_pipe;
        const double shape = r2 <= R2 ? (1.0 - r2/R2) : 0.0;

        bc->uxFluid = 0.0; // x-velocity
        bc->uyFluid = 0.0; // y-velocity
        bc->uzFluid = -u_inflow*shape;  // z-velocity --> parabolic inflow profile
      }
  } else if (isField("fluid pressure")) {
    bc->pFluid = 0.0;
  } else if (isField("scalar temperature")) {
    // inlet boundary condition
    if (bc->id == 1)
      {
        bc->sScalar = 0.0;
      }
    // wall boundary condition (fluid-solid shared interface)
    if (bc->id == 3)
      {
        bc->sScalar = bc->usrwrk[bc->idxVol + 1 * bc->fieldOffset]; // temperature sent from MOOSE
      }
  }
}
